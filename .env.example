# ─── 应用 ───
APP_NAME=Find
ENVIRONMENT=dev
DEBUG=true
DB_ECHO=false
LOG_LEVEL=INFO

# ─── 数据库（Postgres + pgvector）───
POSTGRES_USER=find
POSTGRES_PASSWORD=find
POSTGRES_DB=find
DATABASE_URL=postgresql+asyncpg://find:find@localhost:5432/find

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── DeepSeek API（https://platform.deepseek.com）───
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASON_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=true

# ─── BGE-M3 向量化服务 ───
EMBEDDING_SERVICE_URL=http://localhost:8001
EMBEDDING_DIM=1024
EMBEDDING_MODEL=BAAI/bge-m3

# ─── 对象存储（MinIO / S3）───
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=find-media
S3_REGION=us-east-1
# 本地存储后端（STORAGE_BACKEND=local 时生效）
LOCAL_MEDIA_DIR=.data/media
MEDIA_BASE_URL=http://localhost:8000/media

# ─── 认证 ───
JWT_SECRET=change-me-to-a-random-32-byte-secret-value
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── 匹配参数 ───
MATCH_RECALL_K=20
MATCH_HIGH_THRESHOLD=0.75
MATCH_MID_THRESHOLD=0.50

# ─── 数据留存（认领成功后清理天数）───
RETENTION_DAYS_AFTER_CLAIM=7

# ─── 可观测（可选）───
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
